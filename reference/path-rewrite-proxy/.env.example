# ── Upstream gateway ──────────────────────────────────────────
# Gateway origin (no trailing slash). Placeholder — replace with yours.
GATEWAY_BASE_URL=https://your-gateway.example.com

# Non-standard path prefix the gateway expects.
# Standard OpenAI = leave empty. Zhipu/GLM-style gateways = /v1/model
GATEWAY_PATH_PREFIX=/v1/model

# Force-rewrite request body "model" to this single value.
# Empty = use MODEL_REWRITE_MAP, or passthrough the original model if that is also empty.
GATEWAY_MODEL=

# Per-name model rewrite map (JSON). Used only when GATEWAY_MODEL is empty.
# MODEL_REWRITE_MAP={"sonnet":"your-model","claude-sonnet-4-20250514":"your-model"}

# Real Bearer key. Read by this process only — NEVER commit, NEVER log.
GATEWAY_API_KEY=sk-replace-me

# ── Proxy server ──────────────────────────────────────────────
PROXY_PORT=8423
BIND_HOST=127.0.0.1
